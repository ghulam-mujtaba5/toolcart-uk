# =============================================================================
# ToolCart UK - Environment Variables Configuration
# Reference: docs/07_LAUNCH_GATES_AND_GOVERNANCE.md
# =============================================================================

# Application Environment & Launch Governance
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
STAGING_ONLY=true
ALLOW_MOCK_STRIPE_WEBHOOKS=false
ALLOW_MOCK_STRIPE_PAYMENTS=false
# Required for deployed /api/admin routes. Use a real session provider before launch;
# routes fail closed when this value is absent.
ADMIN_API_TOKEN=replace_with_a_long_random_value

# Supabase PostgreSQL & Auth (set in the deployment environment, never commit live values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret

# Cloudflare R2 Object Storage (Account 6c9035e2ddbac196ef20ce5bfd9469cd)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key
R2_SECRET_ACCESS_KEY=replace_with_r2_secret
R2_BUCKET_NAME=your_r2_bucket
R2_PUBLIC_URL=https://assets.example.co.uk

# Resend Transactional Email
RESEND_API_KEY=replace_with_resend_key
RESEND_FROM_EMAIL=ToolCart <orders@example.co.uk>
ADMIN_NOTIFICATION_EMAIL=ops@example.co.uk

# Stripe Test Mode (Integer Pence GBP)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock_51Q_toolcart_publishable_key
STRIPE_SECRET_KEY=sk_test_mock_51Q_toolcart_secret_key
STRIPE_WEBHOOK_SECRET=whsec_mock_toolcart_webhook_secret

# Google Gemini AI Chatbot
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
